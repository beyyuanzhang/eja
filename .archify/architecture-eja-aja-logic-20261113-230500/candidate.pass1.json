    {
      "kind": "region",
      "label": "EJA 主体（持久）",
      "wraps": [
        "log",
        "fold",
        "state",
        "projection",
        "brain",
        "decision"
      ]
    },
    {
      "kind": "region",
      "label": "AJA 节点（一次性）",
      "wraps": [
        "worker",
        "aja",
        "tools",
        "record"
