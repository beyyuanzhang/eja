  "cards": [
    {
      "dot": "rose",
      "title": "节点产物现在有四种表示",
      "items": [
        "Record：node.json + context.jsonl（磁盘上的完整记录）",
        "Digest：宿主的 fold（步骤、调用、diff、结尾）",
        "Artifacts：从私有区拷出的文件副本",
        "Project diff：世界真实发生的变化"
      ]
    },
    {
      "dot": "cyan",
      "title": "fold 与 digest 是同一个操作",
      "items": [
        "log → fold → State（主体记忆）",
        "context.jsonl → fold → Digest（节点记忆）",
        "差别的只是输入不同，操作是同一种"
      ]
    },
    {
      "dot": "amber",
      "title": "冗余点",
      "items": [
        "Artifacts 复制了 Project 已有的文件",
        "私有区让 write_file 与 shell 写入不同世界",
        "一个节点的结果因此有两条入账路径"
      ]
    },
    {
      "dot": "violet",
      "title": "EJA 的读（look）",
      "items": [
        "look {log | node | world} 是唯一读原语",
        "log：按 id / search 查事件",
        "node：读节点记录与文件",
        "world：只读地看项目"
      ]
    }
  ],
